# Variáveis de ambiente
.env
.env.*
!.env.example

# Arquivos de log
*.log
npm-debug.log
yarn-error.log

# Git
.git
.gitignore

# Documentação e arquivos do sistema
*.md
.DS_Store

# IDEs e editores
.vscode/
.idea/

# Testes e cobertura
tests/
__tests__/
coverage/

# Ignora tudo da raiz que não seja backend ou frontend
/*
!backend/
!frontend/

# Ignora dependências locais e arquivos de build
**/node_modules/
**/dist/
**/.next/
**/.vite/
**/.cache/

# Arquivos relacionados ao Docker (não devem ir para o build final)
Dockerfile
.dockerignore
