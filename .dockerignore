# ----------------------------
# IGNORA ARQUIVOS SENSÍVEIS E DE SISTEMA
# ----------------------------

.env
.env.*
!.env.example
!frontend/.env  # Permitir o .env do frontend ir para o Git (necessário para Railway)

# Logs e relatórios
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnóstico
report.*

# Runtime
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage
*.lcov
.nyc_output

# Cache e build
dist/
.build/
.cache/
.next/
.nuxt/
out/
.temp
.webpack/

# Diretórios de dependências
node_modules/
jspm_packages/
bower_components/
web_modules/
.yarn/
.pnp.*

# Arquivos de controle
*.tsbuildinfo
.lock-wscript
.yarn-integrity
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_*/
.parcel-cache

# Histórico
.node_repl_history

# VSCode / IDEs
.vscode/
.idea/
.vscode-test/

# Outros
.docusaurus/
.serverless/
.fusebox/
.dynamodb/
.tern-port

# Arquivos específicos de ferramentas
*.tgz

# ----------------------------
# IGNORA TUDO QUE NÃO SEJA backend/ E frontend/
# ----------------------------

# Ignorar tudo por padrão
**

# Permitir backend e frontend
!backend/
!backend/**
!frontend/
!frontend/**

# Permitir arquivos necessários na raiz (Dockerfile, .dockerignore, etc.)
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!vite.config.js
!index.html
!nginx.conf
!eslint.config.js
!app.env
